#
# Common firmware configuration, layered under boards/<name>.defaults.
#
# Here are the settings that are true of the firmware itself, whatever it
# is built for.

# A controller-only Bluetooth HCI controller with no host stack.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_CONTROLLER_ENABLED=y
