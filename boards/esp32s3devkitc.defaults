#
# Board: ESP32-S3-DevKitC-1
#
# ESP32-S3 (dual-core Xtensa), WROOM-1-N8 module (8 MB flash). The native "USB"
# socket runs the USB-OTG controller as a standard USB Bluetooth HCI dongle (BTH
# class) via TinyUSB, so the board enumerates as a Bluetooth adapter (Linux
# btusb -> hciX). Console/logs stay on UART0 (the "UART" / CP2102 socket).
# Layered on top of the common sdkconfig.defaults by:
#   idf.py -DBOARD=esp32s3devkitc set-target esp32s3 build
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Status LED: the onboard WS2812B. GPIO48 on DevKitC-1 v1.0; set 38 for v1.1.
CONFIG_UNCHAINED_LED_ENABLED=y
CONFIG_UNCHAINED_LED_GPIO=48
CONFIG_UNCHAINED_LED_COUNT=1

# Controller VHCI
CONFIG_BT_CTRL_HCI_MODE_VHCI=y

# HCI transport: native USB-OTG, BTH class (TinyUSB).
CONFIG_UNCHAINED_HCI_OVER_USB_BTH=y

# The USB-OTG owns the native USB pins, so nothing else may: keep the console on
# UART0 and disable the USB-Serial/JTAG secondary console.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# TinyUSB: expose only the Bluetooth (BTH) device class. The 6 ISO alt settings
# give the voice/SCO interface the USB BT spec mandates; Microsoft's bthusb.sys
# refuses to start the radio without it (Linux btusb does not need it).
CONFIG_TINYUSB_BTH_ENABLED=y
CONFIG_TINYUSB_BTH_ISO_ALT_COUNT=6
CONFIG_TINYUSB_CDC_ENABLED=n
