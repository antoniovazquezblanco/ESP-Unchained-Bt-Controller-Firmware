#
# Board: SCAPYCON 2026 badge
# https://github.com/dissecto-GmbH/scapycon-2026-badge-firmware
#
# ESP32-C5, 4 MB flash, native USB-Serial/JTAG (USB D+/D- on GPIO14/GPIO13).
# Layered on top of the common sdkconfig.defaults by:
#   idf.py -DBOARD=scapycon2026badge set-target esp32c5 build
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Status LED: the 6-pixel SK6805 strip on GPIO10. PCB chain order is
# U6,U7 (Scapy logo) -> U9,U10 (V2X logo) -> U11,U12 (Bluetooth logo). Show
# controller status on the Bluetooth-logo pair (indices 4-5), hold the Scapy logo
# (0-1) green, and leave the V2X pair (2-3) off. Battery-powered, so keep the
# ceiling conservative.
CONFIG_UNCHAINED_LED_ENABLED=y
CONFIG_UNCHAINED_LED_GPIO=10
CONFIG_UNCHAINED_LED_COUNT=6
CONFIG_UNCHAINED_LED_STATUS_FIRST=4
CONFIG_UNCHAINED_LED_STATUS_COUNT=2
CONFIG_UNCHAINED_LED_ACCENT_FIRST=0
CONFIG_UNCHAINED_LED_ACCENT_COUNT=2
CONFIG_UNCHAINED_LED_ACCENT_RGB=0x00FF00
CONFIG_UNCHAINED_LED_BRIGHTNESS=64

# HCI transport
# Use the badge's single USB-C socket, which is wired to the
# chip's native USB-Serial/JTAG.
CONFIG_BT_LE_HCI_INTERFACE_USE_RAM=y
CONFIG_UNCHAINED_HCI_OVER_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Display: ST7789 SPI TFT, HS20HS072RX, 240x320 panel mounted landscape.
CONFIG_UNCHAINED_DISPLAY_ENABLED=y
CONFIG_UNCHAINED_DISPLAY_SPI_HOST=1
CONFIG_UNCHAINED_DISPLAY_SCLK_GPIO=6
CONFIG_UNCHAINED_DISPLAY_MOSI_GPIO=1
CONFIG_UNCHAINED_DISPLAY_CS_GPIO=9
CONFIG_UNCHAINED_DISPLAY_DC_GPIO=8
CONFIG_UNCHAINED_DISPLAY_RST_GPIO=0
CONFIG_UNCHAINED_DISPLAY_BL_GPIO=3
CONFIG_UNCHAINED_DISPLAY_PCLK_HZ=20000000
CONFIG_UNCHAINED_DISPLAY_WIDTH=320
CONFIG_UNCHAINED_DISPLAY_HEIGHT=240
